# Flutter app build artifacts (platform-specific ignores live in
# android/.gitignore, ios/.gitignore, macos/.gitignore, windows/.gitignore).

**/doc/api/
ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
/build/

# Third-party license manifest, written by hook/build.dart
/assets/licenses/

# Native build output dirs (kept out of the per-platform .gitignore files)
/ios/build/
/android/build/

# Obfuscation symbol maps (flutter build --split-debug-info=splitMap)
app.*.symbols
app.*.map.json
/splitMap/
