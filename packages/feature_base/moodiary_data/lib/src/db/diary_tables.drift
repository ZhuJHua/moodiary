-- 日记域 schema（diaries + 三张子表 + FTS5 虚表）。全库约定见 database.dart 类注释；
-- 改 schema = 追加 user_version 迁移档，不改已发布的建表语句。

-- 日记本体。主键即业务 uuid；rid 是显式 rowid 别名，**唯一用途是 FTS5 对齐**
-- （隐式 rowid 会被 VACUUM 挪动），不出仓储层、不被任何子表引用。
CREATE TABLE diaries (
  rid           INTEGER PRIMARY KEY,
  id            TEXT NOT NULL UNIQUE,
  category_id   TEXT,
  title         TEXT NOT NULL,
  content       TEXT NOT NULL,
  content_text  TEXT NOT NULL,
  time          INTEGER NOT NULL,
  last_modified INTEGER NOT NULL,
  show          INTEGER NOT NULL,
  mood          TEXT NOT NULL,
  type          TEXT NOT NULL,
  aspect        REAL,
  place_id      TEXT,
  weather_icon  TEXT,
  weather_temp  TEXT,
  weather_text  TEXT
) AS DiaryRow;

-- 第二排序键 id 与 Dart 侧 diarySortComparator 逐字段一致（uuid v7 按创建时刻
-- 有序）——LoadMoreMixin 的分页 offset 与事件内存增量依赖这条对齐。
CREATE INDEX idx_diaries_show_time ON diaries (show, time DESC, id DESC);
CREATE INDEX idx_diaries_show_cat_time
  ON diaries (show, category_id, time DESC, id DESC);
CREATE INDEX idx_diaries_show_lastmod
  ON diaries (show, last_modified DESC, id DESC);

-- 媒体引用（正文派生缓存，seq = 正文出现序）与标签。
CREATE TABLE diary_media (
  diary_id  TEXT NOT NULL REFERENCES diaries (id) ON DELETE CASCADE,
  kind      TEXT NOT NULL,
  seq       INTEGER NOT NULL,
  file_name TEXT NOT NULL,
  PRIMARY KEY (diary_id, kind, seq)
) AS DiaryMediaRow;

CREATE INDEX idx_diary_media_kind ON diary_media (kind, diary_id);
CREATE INDEX idx_diary_media_file ON diary_media (file_name);

CREATE TABLE diary_tags (
  diary_id TEXT NOT NULL REFERENCES diaries (id) ON DELETE CASCADE,
  seq      INTEGER NOT NULL,
  tag      TEXT NOT NULL,
  PRIMARY KEY (diary_id, seq)
) AS DiaryTagRow;

CREATE INDEX idx_diary_tags_tag ON diary_tags (tag);

-- 双链（有向 src→dst；dst 允许悬空——目标可能不存在或后创建，故无外键）。
CREATE TABLE diary_links (
  src_id TEXT NOT NULL REFERENCES diaries (id) ON DELETE CASCADE,
  dst_id TEXT NOT NULL,
  PRIMARY KEY (src_id, dst_id)
) AS DiaryLinkRow;

CREATE INDEX idx_diary_links_dst ON diary_links (dst_id);

-- 分词器 simple 由 sqlite3_simple 注册，中文按字切并额外产出拼音同位 token。
CREATE VIRTUAL TABLE diary_fts USING fts5(
  title,
  content_text,
  content='diaries',
  content_rowid='rid',
  tokenize='simple'
);

CREATE TRIGGER diary_fts_ai AFTER INSERT ON diaries BEGIN
  INSERT INTO diary_fts (rowid, title, content_text)
    VALUES (new.rid, new.title, new.content_text);
END;

CREATE TRIGGER diary_fts_ad AFTER DELETE ON diaries BEGIN
  INSERT INTO diary_fts (diary_fts, rowid, title, content_text)
    VALUES ('delete', old.rid, old.title, old.content_text);
END;

CREATE TRIGGER diary_fts_au AFTER UPDATE OF title, content_text ON diaries
WHEN old.title IS NOT new.title OR old.content_text IS NOT new.content_text
BEGIN
  INSERT INTO diary_fts (diary_fts, rowid, title, content_text)
    VALUES ('delete', old.rid, old.title, old.content_text);
  INSERT INTO diary_fts (rowid, title, content_text)
    VALUES (new.rid, new.title, new.content_text);
END;
