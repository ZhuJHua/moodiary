-- 日记域 schema（diaries + 三张子表 + FTS5 虚表）。全库约定见 database.dart 类注释；
-- 改 schema = 追加 user_version 迁移档，不改已发布的建表语句。

-- 日记本体。主键即业务 uuid；rid 是显式 rowid 别名，**唯一用途是 FTS5 对齐**
-- （隐式 rowid 会被 VACUUM 挪动），不出仓储层、不被任何子表引用。
CREATE TABLE diaries (
  rid           INTEGER PRIMARY KEY,
  id            TEXT NOT NULL UNIQUE,
  category_id   TEXT,
  title         TEXT NOT NULL,
  content       TEXT NOT NULL,
  content_text  TEXT NOT NULL,
  time          INTEGER NOT NULL,
  last_modified INTEGER NOT NULL,
  show          INTEGER NOT NULL,
  mood_level    INTEGER CHECK (mood_level BETWEEN 1 AND 5),
  type          TEXT NOT NULL,
  aspect        REAL,
  place_id      TEXT,
  weather_icon  TEXT,
  weather_temp  TEXT,
  weather_text  TEXT,
  tags_text     TEXT NOT NULL DEFAULT ''
) AS DiaryRow;

-- 第二排序键 id 与 Dart 侧 diarySortComparator 逐字段一致（uuid v7 按创建时刻
-- 有序）——LoadMoreMixin 的分页 offset 与事件内存增量依赖这条对齐。
CREATE INDEX idx_diaries_show_time ON diaries (show, time DESC, id DESC);
CREATE INDEX idx_diaries_show_cat_time
  ON diaries (show, category_id, time DESC, id DESC);
CREATE INDEX idx_diaries_show_lastmod
  ON diaries (show, last_modified DESC, id DESC);
CREATE INDEX idx_diaries_show_cat_lastmod
  ON diaries (show, category_id, last_modified DESC, id DESC);

-- 媒体引用（正文派生缓存，seq = 正文出现序）与标签。
CREATE TABLE diary_media (
  diary_id  TEXT NOT NULL REFERENCES diaries (id) ON DELETE CASCADE,
  kind      TEXT NOT NULL,
  seq       INTEGER NOT NULL,
  file_name TEXT NOT NULL,
  name      TEXT,
  PRIMARY KEY (diary_id, kind, seq)
) AS DiaryMediaRow;

CREATE INDEX idx_diary_media_kind ON diary_media (kind, diary_id);
CREATE INDEX idx_diary_media_file ON diary_media (file_name);

CREATE TABLE tags (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  deleted INTEGER NOT NULL DEFAULT 0,
  last_modified INTEGER NOT NULL
) AS TagRow;
CREATE INDEX idx_tags_name ON tags (name);

CREATE TABLE diary_tags (
  diary_id TEXT NOT NULL REFERENCES diaries (id) ON DELETE CASCADE,
  seq      INTEGER NOT NULL,
  tag_id   TEXT NOT NULL,
  PRIMARY KEY (diary_id, seq)
) AS DiaryTagRow;

CREATE INDEX idx_diary_tags_tag ON diary_tags (tag_id);

CREATE TRIGGER tags_ai AFTER INSERT ON tags BEGIN
  UPDATE diaries SET tags_text = COALESCE((SELECT group_concat(name, ' ') FROM
    (SELECT t.name FROM diary_tags dt JOIN tags t ON t.id = dt.tag_id
     WHERE dt.diary_id = diaries.id AND t.deleted = 0 ORDER BY dt.seq)), '')
  WHERE id IN (SELECT diary_id FROM diary_tags WHERE tag_id = new.id);
END;

CREATE TRIGGER tags_au AFTER UPDATE OF name, deleted ON tags BEGIN
  UPDATE diaries SET tags_text = COALESCE((SELECT group_concat(name, ' ') FROM
    (SELECT t.name FROM diary_tags dt JOIN tags t ON t.id = dt.tag_id
     WHERE dt.diary_id = diaries.id AND t.deleted = 0 ORDER BY dt.seq)), '')
  WHERE id IN (SELECT diary_id FROM diary_tags WHERE tag_id = new.id);
END;

-- 双链（有向 src→dst；dst 允许悬空——目标可能不存在或后创建，故无外键）。
CREATE TABLE diary_links (
  src_id TEXT NOT NULL REFERENCES diaries (id) ON DELETE CASCADE,
  dst_id TEXT NOT NULL,
  PRIMARY KEY (src_id, dst_id)
) AS DiaryLinkRow;

CREATE INDEX idx_diary_links_dst ON diary_links (dst_id);

-- 分词器 simple 由 sqlite3_simple 注册，中文按字切并额外产出拼音同位 token。
CREATE VIRTUAL TABLE diary_fts USING fts5(
  title,
  content_text,
  tags_text,
  content='diaries',
  content_rowid='rid',
  tokenize='simple'
);

CREATE TRIGGER diary_fts_ai AFTER INSERT ON diaries BEGIN
  INSERT INTO diary_fts (rowid, title, content_text, tags_text)
    VALUES (new.rid, new.title, new.content_text, new.tags_text);
END;

CREATE TRIGGER diary_fts_ad AFTER DELETE ON diaries BEGIN
  INSERT INTO diary_fts (diary_fts, rowid, title, content_text, tags_text)
    VALUES ('delete', old.rid, old.title, old.content_text, old.tags_text);
END;

CREATE TRIGGER diary_fts_au AFTER UPDATE OF title, content_text, tags_text ON diaries
WHEN old.title IS NOT new.title OR old.content_text IS NOT new.content_text OR old.tags_text IS NOT new.tags_text
BEGIN
  INSERT INTO diary_fts (diary_fts, rowid, title, content_text, tags_text)
    VALUES ('delete', old.rid, old.title, old.content_text, old.tags_text);
  INSERT INTO diary_fts (rowid, title, content_text, tags_text)
    VALUES (new.rid, new.title, new.content_text, new.tags_text);
END;

-- Deferred until the stored UI language has loaded; never synced as domain data.
CREATE TABLE legacy_mood_scenes (
  diary_id TEXT NOT NULL PRIMARY KEY REFERENCES diaries (id) ON DELETE CASCADE,
  scene TEXT NOT NULL
) AS LegacyMoodSceneRow;
