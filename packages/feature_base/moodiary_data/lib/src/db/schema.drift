-- SQLite schema 真源（2.8.0 起，Isar 已退休）。drift 从这里同时得到建表 DDL 与
-- 类型信息；改 schema = 追加 user_version 迁移档（database.dart 的 onUpgrade），
-- 不改已发布的建表语句——没有 Isar「位置即地址」的枷锁，但已发布档等于历史事实。
--
-- 约定（全表一致）：
-- - 业务主键沿用 uuid v7 字符串 TEXT PRIMARY KEY；
-- - DateTime 一律 INTEGER 存 UTC 微秒（db_codec.dart 的 dbTime/dbToTime）；
-- - 「没有值」是真 NULL，没有哨兵；
-- - 小集合字段（工具快照/模型列表等）留 JSON 文本列，NULL 与 '[]' 语义不同。

-- 日记本体。主键即业务 uuid；rid 是显式 rowid 别名，**唯一用途是 FTS5 对齐**
-- （contentless FTS5 的行地址必须是整数 rowid，且隐式 rowid 会被 VACUUM 挪动），
-- 不出仓储层、不被任何子表引用。
CREATE TABLE diaries (
  rid           INTEGER PRIMARY KEY,
  id            TEXT NOT NULL UNIQUE,
  category_id   TEXT,
  title         TEXT NOT NULL,
  content       TEXT NOT NULL,
  content_text  TEXT NOT NULL,
  time          INTEGER NOT NULL,
  last_modified INTEGER NOT NULL,
  show          INTEGER NOT NULL,
  mood          REAL NOT NULL,
  type          TEXT NOT NULL,
  aspect        REAL,
  latitude      REAL,
  longitude     REAL,
  place_name    TEXT,
  weather_icon  TEXT,
  weather_temp  TEXT,
  weather_text  TEXT
) AS DiaryRow;

-- 第二排序键 id 与 Dart 侧 diarySortComparator 逐字段一致（uuid v7 按创建时刻
-- 有序）——LoadMoreMixin 的分页 offset 与事件内存增量依赖这条对齐。
CREATE INDEX idx_diaries_show_time ON diaries (show, time DESC, id DESC);
CREATE INDEX idx_diaries_show_cat_time
  ON diaries (show, category_id, time DESC, id DESC);
CREATE INDEX idx_diaries_show_lastmod
  ON diaries (show, last_modified DESC, id DESC);

-- 媒体引用（正文派生缓存，seq = 正文出现序）与标签。
CREATE TABLE diary_media (
  diary_id  TEXT NOT NULL REFERENCES diaries (id) ON DELETE CASCADE,
  kind      TEXT NOT NULL,
  seq       INTEGER NOT NULL,
  file_name TEXT NOT NULL,
  PRIMARY KEY (diary_id, kind, seq)
) AS DiaryMediaRow;

CREATE INDEX idx_diary_media_kind ON diary_media (kind, diary_id);
CREATE INDEX idx_diary_media_file ON diary_media (file_name);

CREATE TABLE diary_tags (
  diary_id TEXT NOT NULL REFERENCES diaries (id) ON DELETE CASCADE,
  seq      INTEGER NOT NULL,
  tag      TEXT NOT NULL,
  PRIMARY KEY (diary_id, seq)
) AS DiaryTagRow;

CREATE INDEX idx_diary_tags_tag ON diary_tags (tag);

-- 双链（有向 src→dst；dst 允许悬空——目标可能不存在或后创建，故无外键）。
CREATE TABLE diary_links (
  src_id TEXT NOT NULL REFERENCES diaries (id) ON DELETE CASCADE,
  dst_id TEXT NOT NULL,
  PRIMARY KEY (src_id, dst_id)
) AS DiaryLinkRow;

CREATE INDEX idx_diary_links_dst ON diary_links (dst_id);

-- 全文搜索：预分词 contentless FTS5，rowid = diaries.rid。索引侧写 jieba
-- cut_for_search（高召回）空格拼接，查询侧用 cut（高精度）。列权重（标题 1.5）
-- 由 onCreate 里的 rank 配置行持久化。
CREATE VIRTUAL TABLE diary_fts USING fts5(
  title_tok,
  body_tok,
  content='',
  contentless_delete=1,
  tokenize='unicode61',
  prefix='2',
  detail=full,
  columnsize=1
);

CREATE TABLE categories (
  id            TEXT NOT NULL PRIMARY KEY,
  name          TEXT NOT NULL,
  last_modified INTEGER NOT NULL,
  parent_id     TEXT,
  color         INTEGER
) AS CategoryRow;

CREATE TABLE fonts (
  font_family    TEXT NOT NULL PRIMARY KEY,
  font_file_name TEXT NOT NULL,
  wght_axis_json TEXT NOT NULL DEFAULT '{}'
) AS FontRow;

CREATE TABLE tombstones (
  "key"                TEXT NOT NULL PRIMARY KEY,
  time_ms              INTEGER NOT NULL,
  pushed_backends_json TEXT NOT NULL DEFAULT '[]'
) AS TombstoneRow;

CREATE INDEX idx_tombstones_time ON tombstones (time_ms);

CREATE TABLE media_infos (
  file_name     TEXT NOT NULL PRIMARY KEY,
  name          TEXT,
  duration_ms   INTEGER,
  last_modified INTEGER NOT NULL
) AS MediaInfoRow;

-- AI 助手。API Key 永不入库（SecureKV，`llm_key_<id>`）。
CREATE TABLE llm_providers (
  id            TEXT NOT NULL PRIMARY KEY,
  name          TEXT NOT NULL,
  type          TEXT NOT NULL,
  base_url      TEXT NOT NULL,
  default_model TEXT NOT NULL,
  created_at    INTEGER NOT NULL,
  sort_order    INTEGER NOT NULL,
  preset_id     TEXT NOT NULL DEFAULT '',
  models_json   TEXT NOT NULL DEFAULT '[]',
  tool_call     INTEGER NOT NULL DEFAULT 0,
  reasoning     INTEGER NOT NULL DEFAULT 0,
  attachment    INTEGER NOT NULL DEFAULT 0
) AS LlmProviderRow;

CREATE INDEX idx_llm_providers_sort ON llm_providers (sort_order);

CREATE TABLE chat_sessions (
  id                 TEXT NOT NULL PRIMARY KEY,
  title              TEXT NOT NULL DEFAULT '',
  provider_id        TEXT NOT NULL,
  model              TEXT NOT NULL,
  created_at         INTEGER NOT NULL,
  updated_at         INTEGER NOT NULL,
  reasoning_effort   TEXT NOT NULL DEFAULT '',
  compacted_summary  TEXT,
  compacted_up_to_message_id TEXT,
  compacted_at       INTEGER,
  compacted_input_tokens_at_trigger INTEGER,
  agent_preset_id    TEXT,
  persona_snapshot   TEXT,
  tools_snapshot_json TEXT
) AS ChatSessionRow;

CREATE INDEX idx_chat_sessions_updated ON chat_sessions (updated_at DESC);

CREATE TABLE chat_messages (
  id              TEXT NOT NULL PRIMARY KEY,
  session_id      TEXT NOT NULL
    REFERENCES chat_sessions (id) ON DELETE CASCADE,
  role            TEXT NOT NULL,
  content         TEXT NOT NULL,
  created_at      INTEGER NOT NULL,
  reasoning       TEXT,
  thinking_millis INTEGER,
  image_name      TEXT,
  input_tokens    INTEGER,
  output_tokens   INTEGER,
  model           TEXT
) AS ChatMessageRow;

CREATE INDEX idx_chat_messages_session
  ON chat_messages (session_id, created_at);

-- 原 Isar @Embedded List 拆子表：seq 显式记录顺序，done 流式翻转可单行 UPDATE。
CREATE TABLE assistant_tool_calls (
  message_id TEXT NOT NULL
    REFERENCES chat_messages (id) ON DELETE CASCADE,
  seq        INTEGER NOT NULL,
  call_id    TEXT NOT NULL,
  name       TEXT NOT NULL,
  args_json  TEXT NOT NULL DEFAULT '',
  result     TEXT NOT NULL DEFAULT '',
  done       INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (message_id, seq)
) AS AssistantToolCallRow;

CREATE TABLE memories (
  id         TEXT NOT NULL PRIMARY KEY,
  category   TEXT NOT NULL,
  content    TEXT NOT NULL,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL
) AS MemoryRow;

CREATE INDEX idx_memories_updated ON memories (updated_at DESC);

CREATE TABLE agent_presets (
  id          TEXT NOT NULL PRIMARY KEY,
  name        TEXT NOT NULL,
  description TEXT NOT NULL DEFAULT '',
  persona     TEXT NOT NULL,
  tools_json  TEXT,
  created_at  INTEGER NOT NULL,
  updated_at  INTEGER NOT NULL
) AS AgentPresetRow;
